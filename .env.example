# Cookie Chain Network Configuration
COOKIE_RPC_URL=https://rpc.cookiescan.io
COOKIE_DAS_API=https://api.cookiescan.io
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=production

# --- Deposits / vault opening (keep false until Fase 2 fully deployed) ---
PUBLIC_DEPOSITS_ENABLED=false
CORS_ALLOW_ORIGINS=*
RPC_PROXY_RATE_LIMIT=60

# --- Isolated treasury signer (Fase 2) ---
# The API server points here; the signer service runs on a SEPARATE hardened box.
# Leave SIGNER_URL empty in the API only if you also set ALLOW_SIMULATED_SIGNER=true
# (dev/local ONLY — never in production; withdrawals must not pay from a hot key).
SIGNER_URL=
SIGNER_SHARED_SECRET=
SIGNER_TIMEOUT_SECS=30
ALLOW_SIMULATED_SIGNER=false

# --- Signer-side policy caps (set these ON the signer box) ---
AUTO_PAYOUT_CAP_COOKIE=1000
DAILY_PAYOUT_CAP_COOKIE=10000
# TREASURY_KEYPAIR_PATH=/secure/path/treasury_vault_keypair.json   # signer box only
